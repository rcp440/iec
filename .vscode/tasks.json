{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Iniciar servidor HTTP",
            "type": "shell",
            "command": "python -m http.server 8080",
            "isBackground": true,
            "problemMatcher": {
                "owner": "http-server",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*http.server.*$",
                    "endsPattern": "^.*Serving HTTP.*8080.*$"
                }
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        }
    ]
}
